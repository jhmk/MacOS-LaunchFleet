{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "LaunchFleet",
  "version": "0.1.0",
  "identifier": "io.launchfleet.desktop",
  "build": {
    "frontendDist": "../dist"
  },
  "app": {
    "withGlobalTauri": true,
    "macOSPrivateApi": true,
    "windows": [
      {
        "title": "LaunchFleet",
        "width": 1100,
        "height": 720,
        "minWidth": 800,
        "minHeight": 500,
        "resizable": true,
        "center": true,
        "titleBarStyle": "Overlay",
        "hiddenTitle": true,
        "transparent": true
      }
    ],
    "security": {
      "csp": "default-src 'self'; script-src 'self'; style-src 'self' 'unsafe-inline'; img-src 'self' data:; connect-src 'self' ipc: http://ipc.localhost; object-src 'none'; base-uri 'none'; form-action 'none'; frame-ancestors 'none'"
    }
  },
  "bundle": {
    "active": true,
    "targets": "app",
    "icon": [
      "icons/icon.icns"
    ],
    "category": "Utility",
    "shortDescription": "Manage macOS startup items",
    "longDescription": "LaunchFleet helps you view and disable apps and services that start with your Mac.",
    "macOS": {
      "minimumSystemVersion": "13.0"
    }
  }
}
